MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/techneeds
# Required. 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
PORT=5000
NODE_ENV=development

# Google Gemini key for the AI Profile (optional: without it the page uses a template summary)
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# ── Admin security ─────────────────────────────────────────────
# Used only by `npm run seed`. Min 12 chars. If empty, a random password is generated and printed once.
ADMIN_EMAIL=admin@techneeds.in
ADMIN_PASSWORD=
# Admin sign-in needs a 6-digit authenticator code after the password. Default: true.
# Set to false ONLY for a live demo, never on a real deployment.
ADMIN_2FA_REQUIRED=true
# Admin session length in hours (default 1, max 24)
ADMIN_SESSION_HOURS=1
# Your frontend URL(s), comma separated. Strongly recommended in production.
CORS_ORIGINS=http://localhost:3000
# Hosting proxy hops (default: 1 in production, 0 locally). Needed so lockouts see the real client IP.
# TRUST_PROXY=1
